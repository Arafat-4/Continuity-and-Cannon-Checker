# ==================================================
# Python
# ==================================================

__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
.venv/

# Environment variables
.env
.env.*
!.env.example

# ==================================================
# Backend generated files
# ==================================================

backend/__pycache__/
# Backend generated manuscript data
# Ignore generated backend data by default
backend/data/*

# Keep the pre-analyzed SuperDocs test manuscript
!backend/data/SuperDocs_Continuity_Test_Manuscript/
!backend/data/SuperDocs_Continuity_Test_Manuscript/**


# Keep the storage module
!backend/data/storage.py
!backend/data/__init__.py

# Keep directory structure
!backend/data/.gitkeep
!backend/uploads/.gitkeep

